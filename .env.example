# Goldproof configuration — copy to .env and fill what you need. All are OPTIONAL.
# Nothing here is required for a default local run on a residential machine.

# ── Transcript backend ────────────────────────────────────────────────────────
# local  = youtube-transcript-api (free, no key) — works from a RESIDENTIAL IP.
# hosted = a paid API that fetches server-side — use for cloud/CI/routine runs,
#          because YouTube blocks datacenter IPs (AWS/GCP/Azure) fast.
GOLDPROOF_TRANSCRIPT_BACKEND=local

# Only for the hosted backend:
GOLDPROOF_TRANSCRIPT_HOSTED_PROVIDER=supadata        # supadata | youtube-transcript-io
GOLDPROOF_TRANSCRIPT_API_KEY=                         # key for the chosen hosted provider

# Optional: richer YouTube discovery (falls back to WebSearch if unset)
GOLDPROOF_YOUTUBE_DATA_API_KEY=

# ── X / Twitter (OFF by default) ──────────────────────────────────────────────
# Third-party read API (TwitterAPI.io). NEVER the official X API.
# If this key is unset, X is skipped SILENTLY even when --include-x is passed.
GOLDPROOF_X_API_KEY=
# Hard per-run read cap. The reader refuses to exceed it. ~$0.00015/read =>
# 200 reads ≈ $0.03. (Re-verify the live price before relying on the estimate.)
GOLDPROOF_X_MAX_READS=200

# ── Source-count caps (context + cost control) ────────────────────────────────
GOLDPROOF_MAX_YOUTUBE=8
GOLDPROOF_MAX_WEB=5
